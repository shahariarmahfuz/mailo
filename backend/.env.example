# PostgreSQL Connection String (Neon, Supabase, RDS, Local, etc.)
# Asyncpg driver is used by SQLAlchemy async:
# Example: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>?ssl=require
# If standard "postgresql://" is provided, the application automatically normalizes it to "postgresql+asyncpg://".
DATABASE_URL=postgresql+asyncpg://neondb_owner:YOUR_PASSWORD@ep-soft-meadow-b3dknfac-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?ssl=require

# Authentication & Security
JWT_SECRET=change-this-to-a-super-secret-hex-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Internal Webhook Security (optional secret header for Cloudflare Worker)
INTERNAL_API_KEY=

# Storage Directory for raw MIME .eml files
STORAGE_DIR=storage/emails

# Server Host & Port
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
